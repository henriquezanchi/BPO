      <CompartilharWhatsApp evento={{ ...evento, imagem, interno: true, registrationUrl: "https://portal-na-one.vercel.app/portal?evento=integracao-teste" }} linkTexto={linkWhatsAppDoEvento(evento, "https://portal-na-one.vercel.app/portal")} />
