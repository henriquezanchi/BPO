"use client";
import {EventosTab} from '@/components/director/eventos-tab';
import {EventReception} from '@/components/member/event-reception';
import {EventAttendanceReply} from '@/components/member/event-attendance-reply';
import type {DirectorDashboard} from '@/lib/director-data';
const event={id:'fake-event',title:'Curso fictício',startsAt:new Date('2099-01-01T19:00Z'),endsAt:new Date('2099-01-01T21:00Z'),price:0,audience:'membros',description:'Atividade de teste sem publicação real',location:'Escola teste',revision:0,status:'publicado',source:'manual',staff:[],inscritos:2,presentes:0,registrations:[]};
const data={eventos:[event],membros:[{id:'volunteer',name:'Voluntário teste',mercurioAtivo:true}]} as unknown as DirectorDashboard;
const reception={id:event.id,title:event.title,startsAt:event.startsAt,status:event.status,price:0,registrations:[{id:'r1',paymentState:'gratuito',paid:true,checkedIn:false,checkedInAt:null,selfReportedAttendance:null,mercurioStatus:'aguardando_integracao',member:{name:'Aluno confirmado',registrationNo:1}},{id:'r2',paymentState:'novo',paid:false,checkedIn:false,checkedInAt:null,selfReportedAttendance:null,mercurioStatus:'aguardando_integracao',member:{name:'Aluno pendente',registrationNo:2}}]};
export default function Page(){return <main className="mx-auto max-w-2xl space-y-10 p-4"><h1>Eventos · dados fictícios</h1><section aria-label="Gestão de eventos"><EventosTab schoolId="fake-school" data={data}/></section><section aria-label="Recepção"><EventReception data={reception}/></section><section aria-label="Resposta do aluno"><EventAttendanceReply memberId="fake-member" registrationId="r1"/></section></main>}
