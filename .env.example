# Banco de dados (Supabase Postgres)
# DATABASE_URL = pooler em modo "transaction" (porta 6543) — usado pelo app em runtime
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:6543/postgres"
# DIRECT_URL = pooler em modo "session" (porta 5432) — usado só pelo Prisma Migrate/CLI
# (o pooler em modo transaction não suporta os prepared statements que migrate precisa)
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:5432/postgres"

# Supabase (Auth + client)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Asaas (gateway de pagamento / PIX)
ASAAS_API_KEY=""
ASAAS_ENV="sandbox" # sandbox | production
ASAAS_WEBHOOK_TOKEN="" # gerado localmente (ex: crypto.randomBytes), cadastrar igual no Asaas > Integrações > Webhooks

# WhatsApp (provedor inicial, ex: Z-API)
WHATSAPP_PROVIDER_TOKEN=""
WHATSAPP_PROVIDER_INSTANCE=""

# Mercúrio (leitura/escrita real via automação de navegador — RPA, não há
# API oficial). Credenciais reais ficam cifradas no projeto Supabase do
# scraper/CRM (crm-agencia-na), NÃO no Supabase do BPO acima.
MERCURIO_SUPABASE_URL=""
MERCURIO_SUPABASE_SERVICE_ROLE_KEY=""
MERCURIO_CREDENCIAIS_CHAVE=""

# Fortuna (oinabnfortuna.acropolebrasil.com.br — carteira digital da
# lanchonete). Diferente do Mercúrio: tem API REST real
# (oinabnfortunaback.acropolebrasil.com.br/api), sem RPA. Login hoje é uma
# conta de colaborador (Gerente) real — considerar pedir uma conta de
# serviço dedicada ao suporte do Fortuna antes de produção.
FORTUNA_INSCRICAO=""
FORTUNA_SENHA=""
