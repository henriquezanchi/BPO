# Modelo das variáveis de ambiente do Portal (atualizado em 01/11/2026). Copie para .env.local e preencha.
# Nunca coloque segredo em variável NEXT_PUBLIC_. Em produção, tudo fica na Vercel.
# "obrigatória" = o Portal não sobe ou uma área principal para sem ela; "opcional" = liga um recurso.

# ── Banco de dados (Supabase Postgres) — obrigatórias ──────────────────────────────────────────────
# DATABASE_URL = pooler em modo "transaction" (porta 6543), usado pelo app em runtime.
DATABASE_URL="postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:6543/postgres"
# DIRECT_URL = pooler em modo "session" (porta 5432), usado só pelo Prisma (db execute / migrate resolve).
DIRECT_URL="postgresql://postgres.[ref]:[password]@[host].pooler.supabase.com:5432/postgres"

# ── Supabase Auth — obrigatórias ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Segredos internos — obrigatórias ───────────────────────────────────────────────────────────────
CRON_SECRET=""            # a Vercel chama /api/cron/* com "Authorization: Bearer $CRON_SECRET"
SEGREDO_SESSAO=""         # assina a sessão da tesouraria (src/pages/api/tesouraria)
MATRICULA_CPF_CHAVE=""    # 32 bytes em base64; cifra o CPF da matrícula on-line (AES-256-GCM)
PORTAL_URL="https://portal-na-one.vercel.app"  # endereço público, usado em links de avisos
# DONOS_DO_SISTEMA="21596"  # matrículas do Mercúrio com acesso total, separadas por vírgula (padrão: 21596)

# ── Login unificado da Acrópole (Keycloak do Ágora, realm oinabnb) — obrigatória para o login unificado
KEYCLOAK_CLIENT_SECRET=""
# KEYCLOAK_OFFLINE=1      # opcional: sessão sem o Keycloak, só para desenvolvimento

# ── Ponte Cloudflare (diário antigo / informes) — obrigatórias para o diário importado ─────────────
PONTE_URL=""
PONTE_CHAVE=""

# ── Asaas (cobranças) ─────────────────────────────────────────────────────────────────────────────
# Toda cobrança sai pela subconta da filial (School.asaasSubaccountApiKey, gravada por scripts/ligar-subconta-asaas.ts).
# A chave principal serve só para consultas, criação de subcontas e cobranças antigas.
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"       # sandbox | production
ASAAS_WEBHOOK_TOKEN=""    # gerado localmente; cadastrar igual em Asaas > Integrações > Webhooks (conta e subcontas)
# ASAAS_WALLET_ID_PRINCIPAL=""     # opcional: carteira do BPO para o split
# ASAAS_SAQUE_TOKEN=""             # opcional: saques automáticos
# ASAAS_SAQUE_OUTROS_APROVADOS=""  # opcional: outras contas aprovadas para saque
# PIX_AUTOMATICO_UNIDADES=""       # opcional: siglas das filiais com Pix Automático liberado, separadas por vírgula

# ── Mercúrio (sistema da Acrópole; sem API oficial) ───────────────────────────────────────────────
# Banco de consulta (phpMyAdmin do Mercúrio atrás de "Restricted Files") — obrigatórias para importação e resumos
MERCURIO_PMA_URL=""
MERCURIO_PMA_USER=""
MERCURIO_PMA_PASS=""
MERCURIO_DB_HTTP_USUARIO=""
MERCURIO_DB_HTTP_SENHA=""
# Escrita por robô (Playwright). As credenciais ficam cifradas no Supabase do scraper, não no do Portal.
MERCURIO_SUPABASE_URL=""
MERCURIO_SUPABASE_SERVICE_ROLE_KEY=""
MERCURIO_CREDENCIAIS_CHAVE=""
# MERCURIO_USAR_MOCK=1    # só em teste: adaptador falso. Nunca em produção.
# HEADLESS_DEBUG=1        # só em desenvolvimento: abre o navegador do robô

# ── Mercury (API da Acrópole) e Ulisses (eventos) ─────────────────────────────────────────────────
MERCURY_API_KEY=""
ULISSES_API_CLIENT_ID=""
ULISSES_API_CLIENT_SECRET=""
# ULISSES_CLIENT_MODULE=""  # opcional
# ULISSES_SCHOOL_MAP=""     # opcional: mapa sigla→id de escola do Ulisses

# ── Fortuna (carteira da lanchonete; API REST) ────────────────────────────────────────────────────
FORTUNA_INSCRICAO=""
FORTUNA_SENHA=""

# ── Avisos ────────────────────────────────────────────────────────────────────────────────────────
CALLMEBOT_PHONE=""        # WhatsApp de alertas internos (suporte/dono)
CALLMEBOT_APIKEY=""
# VAPID_PUBLIC_KEY=""     # opcional: push no navegador (sem as três, o botão diz "ainda não liberadas")
# VAPID_PRIVATE_KEY=""
# PUSH_SUBJECT="mailto:suporte@exemplo.com"
# ZERNIO_API_KEY=""              # WhatsApp/Instagram: desligado por decisão do usuário (26/10/2026)
# ZERNIO_WHATSAPP_ACCOUNT_ID=""  # NÃO configurar enquanto a decisão valer
# ZERNIO_WEBHOOK_SECRET=""

# ── Recursos opcionais ────────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=""              # resumos por IA, busca inteligente, leitura de cartazes, resumo da TV
# TURNSTILE_SECRET_KEY=""           # Cloudflare Turnstile na matrícula pública (inativo sem as duas)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# ACROPOLE_PLAY_ENCRYPTION_KEY=""   # importação manual da Acrópole Play
# NATIONAL_CALENDAR_ICS_URL=""      # calendário nacional em ICS
# ENABLE_LEGACY_NATIONAL_CALENDAR_IMPORT=""


# ── Só para scripts locais (não vão para a Vercel) ────────────────────────────────────────────────
# CRM_SUPABASE_URL="" / CRM_SUPABASE_SERVICE_ROLE_KEY="" / CRM_CREDENCIAIS_SCRAPER_CHAVE=""   (scripts/mercurio-*-test.ts)
# SCRAPER_SUPABASE_URL="" / SCRAPER_SUPABASE_SERVICE_ROLE_KEY="" / CREDENCIAIS_SCRAPER_CHAVE="" (scripts/sync-ulisses-events.ts)
# ASAAS_API_KEY_BG=""   (scripts/ligar-subconta-asaas.ts --da-env)
