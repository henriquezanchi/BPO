// Schema inicial do MVP - Portal do Membro & BPO Financeiro
// Referência: protótipos demo-whatsapp.html, portal (visão do diretor).html, portal (visão do membro).html

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  em_dia
  atrasado
  negociando
  isento
}

enum ContributionStatus {
  pendente
  pago
  atrasado
}

enum ChargeTriggerType {
  inicio_mes
  vencimento
  fim_mes
  atraso_30
  atraso_60
}

enum ClassRole {
  aluno
  professor
}

enum ActivityType {
  prova
  trabalho
  leitura
  atividade_turma
}

enum NotificationChannel {
  whatsapp
  push
}

enum NotificationStatus {
  pendente
  enviado
  falhou
}

enum MercurioSyncStatus {
  pendente
  sincronizado
  falhou
}

model School {
  id                  String   @id @default(cuid())
  name                String
  city                String?
  whatsapp            String? // número da secretaria/economia, usado no botão de ajuda do Portal
  mercurioFilialLabel String? // texto do link "CADASTRO" da filial no Mercúrio (ex: "BARRA DO GAR" — usado como regex de match, não precisa ser exato)
  createdAt           DateTime @default(now())

  members            Member[]
  events             Event[]
  payables           Payable[]
  chargingRules      ChargingRule[]
  classGroups        ClassGroup[]
  compositionCatalog SchoolCompositionCatalogItem[]
}

model Member {
  id             String       @id @default(cuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id])
  mercurioId     String?      @unique // matrícula no Mercúrio (ex: "21596"), quando conhecida
  authUserId     String?      @unique // id do usuário no Supabase Auth (login por e-mail/senha) — ver src/lib/auth.ts
  registrationNo String? // "Matrícula #21596"
  name           String
  whatsapp       String
  whatsappAlt    String? // "Telefone Alternativo" do Mercúrio (2º par Celular/Alternativo)
  email          String?
  // Endereço estruturado (não um campo único de texto) pra permitir
  // autopreenchimento nativo do celular/Google no formulário do Portal —
  // ver src/components/member/panels/profile-edit-panel.tsx. Composto de
  // volta num Logradouro único só na hora de escrever no Mercúrio (que usa
  // 1 campo de texto livre pra rua+número+complemento), em
  // src/lib/mercurio/playwright-adapter.ts.
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String? // UF, 2 letras
  addressZip          String?
  // "Mais Dados" (aba PESSOAIS + IDENTIFICAÇÃO do Mercúrio) — ver
  // src/app/(member)/portal/mais-dados. escolaridade/estadoCivil guardam o
  // CÓDIGO que o Mercúrio usa (ex: "GRP", "SOL"), não o texto — ver
  // src/lib/mercurio/personal-data-options.ts.
  birthDate      DateTime?
  naturalidade   String? // "cidade/UF" (formato livre, como o Mercúrio grava)
  profession     String?
  escolaridade   String?
  estadoCivil    String?
  rgNumero       String?
  rgOrgaoEmissor String?
  rgDataEmissao  DateTime?
  // Situação real no Mercúrio (ATI/INA) — sincronizada periodicamente via
  // scripts/sync-active-status.ts (lê a lista de Ativos da filial inteira
  // numa sessão só, mais eficiente que checar 1 aluno por vez). Verificado
  // no login (src/lib/auth.ts) pra impedir quem saiu da escola de manter
  // acesso ao Portal — não é uma checagem ao vivo a cada login por
  // velocidade, então pode ficar desatualizado até a próxima sincronização.
  mercurioAtivo     Boolean   @default(true)
  mercurioAtivoSync DateTime? // última vez que este campo foi sincronizado de verdade
  status         MemberStatus @default(em_dia)
  createdAt      DateTime     @default(now())

  contributions        Contribution[]
  compositionItems     ContributionCompositionItem[]
  receipts             ContributionReceipt[]
  fortunaTx            FortunaTransaction[]
  crmContacts          CrmContact[]
  eventRegistr         EventRegistration[]
  classMemberships     ClassMembership[]
  createdActivities    Activity[]             @relation("ActivityCreator")
  activityNotifs       ActivityNotification[]
  contactChangeLogs    ContactChangeLog[]
  mercurioSyncTasks    MercurioSyncTask[]

  @@index([schoolId])
}

model Contribution {
  id         String              @id @default(cuid())
  memberId   String
  member     Member              @relation(fields: [memberId], references: [id])
  amount     Decimal             @db.Decimal(10, 2)
  dueDate    DateTime
  paidAt     DateTime?
  status     ContributionStatus  @default(pendente)
  gatewayRef String? // id da cobrança no Asaas
  createdAt  DateTime            @default(now())

  @@index([memberId])
}

// ===================== Composição das Contribuições =====================
// Espelha a tela "Composição das Contribuições" do Mercúrio
// (tesoura/tes_conedit.php) — a lista de itens que somados formam a
// mensalidade do membro (ex: CONTRIBUIÇÃO BIBLIOTECA, CC FILIAL, DIRIGENTE...).
// mercurioGroupId é o "grp" da URL de lá — identifica o item de verdade,
// usado pra editar/excluir no Mercúrio. addedViaPortal marca o que o
// PRÓPRIO membro incluiu pelo Portal — regra de negócio explícita: só
// esses podem ser editados/excluídos por ele; itens que já vieram do
// Mercúrio (lançados pela tesouraria) são só leitura no Portal.
model ContributionCompositionItem {
  id              String   @id @default(cuid())
  memberId        String
  member          Member   @relation(fields: [memberId], references: [id])
  mercurioGroupId String // "grp" no Mercúrio
  label           String // "CONTRIBUIÇÃO BIBLIOTECA"
  amount          Decimal  @db.Decimal(10, 2)
  addedViaPortal  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([memberId, mercurioGroupId])
  @@index([memberId])
}

// Catálogo de tipos de rubrica ("Itens de Contribuição") de uma filial,
// sincronizado periodicamente (scripts/sync-composition.ts) em vez de lido
// ao vivo a cada clique no Portal — na prática são poucos tipos fixos por
// filial (ex: CONTRIBUIÇÃO BIBLIOTECA, CC FILIAL, DIRIGENTE) que quase nunca
// mudam. "Disponível pra incluir" pra um membro específico = este catálogo
// menos os mercurioGroupId que ele já tem em ContributionCompositionItem.
model SchoolCompositionCatalogItem {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  mercurioGroupId String
  label           String
  syncedAt        DateTime @default(now())

  @@unique([schoolId, mercurioGroupId])
  @@index([schoolId])
}

// Comprovantes reais de pagamento (recibos de caixa emitidos pela
// tesouraria — tesoura/tes_cailstr.php + tes_conprt.php no Mercúrio).
// A LISTA (mercurioRecId, issuedAt, amount, probablyCanceled) vem de uma
// sincronização em lote por escola (scripts/sync-receipts.ts, varre a
// listagem mensal — barata, não abre o documento de cada recibo). O
// CONTEÚDO (rawText) só é buscado sob demanda, na primeira vez que o
// membro pede pra ver/baixar um recibo específico (fila MercurioSyncTask,
// taskType "buscar_recibo") — e cacheado pra sempre depois, porque um
// recibo já emitido é um documento histórico imutável (só pode ser
// cancelado, nunca alterado).
model ContributionReceipt {
  id               String    @id @default(cuid())
  memberId         String
  member           Member    @relation(fields: [memberId], references: [id])
  mercurioRecId    String    @unique // "rec" no Mercúrio (ex: "1346179")
  issuedAt         DateTime
  amount           Decimal   @db.Decimal(10, 2)
  // Heurística da listagem (linha sem o link "Cancela") — só pré-triagem,
  // não é definitiva (ver nota em browser-session.ts:lerRecibosDoMes).
  probablyCanceled Boolean   @default(false)
  rawText          String?   @db.Text
  // null = conteúdo nunca buscado, ainda não confirmado. true/false =
  // confirmado de verdade ao ler o documento (tem/não tem "CANCELADO").
  canceled         Boolean?
  fetchedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([memberId])
}

model FortunaTransaction {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  amount    Decimal  @db.Decimal(10, 2) // positivo = recarga, negativo = consumo
  type      String // recarga | consumo
  note      String?
  createdAt DateTime @default(now())

  @@index([memberId])
}

model CrmContact {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  channel   String // whatsapp | telefone | presencial
  hadReply  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())

  @@index([memberId])
}

model ChargingRule {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  name     String // "Régua Padrão", "Régua Suave", "Régua de Resgate"
  triggers ChargeTrigger[]

  @@index([schoolId])
}

model ChargeTrigger {
  id             String            @id @default(cuid())
  chargingRuleId String
  chargingRule   ChargingRule      @relation(fields: [chargingRuleId], references: [id])
  type           ChargeTriggerType
  active         Boolean           @default(true)
  messageTemplate String           @db.Text

  @@index([chargingRuleId])
}

model Event {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  title       String
  startsAt    DateTime
  price       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  registrations EventRegistration[]

  @@index([schoolId])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  paid      Boolean  @default(false)
  checkedIn Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([memberId])
}

model Payable {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  vendor     String
  amount     Decimal   @db.Decimal(10, 2)
  dueDate    DateTime
  hasInvoice Boolean   @default(false)
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([schoolId])
}

// ===================== Turmas, Professores e Agenda =====================
// Fonte de verdade da matrícula/papel (aluno x professor) é o Mercúrio;
// aqui replicamos o necessário para orientar a UI e permitir o cadastro
// de atividades mesmo antes de fechar o formato exato da integração.

model ClassGroup {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  name            String // "Curso de Filosofia - Turma A"
  mercurioClassId String? // id da turma no Mercúrio, quando soubermos o formato
  createdAt       DateTime @default(now())

  memberships ClassMembership[]
  activities  Activity[]

  @@index([schoolId])
}

model ClassMembership {
  id           String     @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id])
  role         ClassRole // aluno | professor nesta turma
  createdAt    DateTime   @default(now())

  @@unique([classGroupId, memberId, role])
  @@index([memberId])
}

// Atividade cadastrada pelo professor (prova, trabalho, leitura...) e
// exibida para os alunos da turma dentro de "Agenda & Eventos" no Portal
// do Membro (não é uma seção nova — reaproveita a caixinha existente).
model Activity {
  id           String       @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id])
  createdById  String
  createdBy    Member       @relation("ActivityCreator", fields: [createdById], references: [id])
  type         ActivityType
  title        String
  studyItems   String?      @db.Text // itens/conteúdo a estudar
  description  String?      @db.Text
  dueDate      DateTime
  createdAt    DateTime     @default(now())

  notifications ActivityNotification[]

  @@index([classGroupId])
}

// Registro de envio de notificação por aluno (WhatsApp hoje; push como
// evolução futura via PWA). Permite reenviar e auditar quem foi avisado.
model ActivityNotification {
  id         String              @id @default(cuid())
  activityId String
  activity   Activity            @relation(fields: [activityId], references: [id])
  memberId   String
  member     Member              @relation(fields: [memberId], references: [id])
  channel    NotificationChannel @default(whatsapp)
  status     NotificationStatus  @default(pendente)
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([activityId])
  @@index([memberId])
}

// ===================== Auditoria de Cadastro =====================
// Toda alteração de contato feita pelo aluno no Portal gera um registro
// com o antes/depois. Se o aluno estiver com contribuição em atraso no
// momento da alteração, a secretaria de economia é alertada (alertedEconomia).
model ContactChangeLog {
  id               String   @id @default(cuid())
  memberId         String
  member           Member   @relation(fields: [memberId], references: [id])
  oldValues        Json
  newValues        Json
  memberWasOverdue Boolean  @default(false)
  alertedEconomia  Boolean  @default(false)
  acknowledgedAt   DateTime?
  createdAt        DateTime @default(now())

  @@index([memberId])
}

// ===================== Fila de Sincronização com o Mercúrio =====================
// Abstração de transporte: cada alteração feita no Portal que precisa
// refletir no Mercúrio vira uma tarefa aqui. O worker que efetivamente
// escreve no Mercúrio (API, acesso a banco ou RPA — a definir) consome
// esta fila, então trocar de transporte não muda o resto do sistema.
model MercurioSyncTask {
  id        String             @id @default(cuid())
  memberId  String
  member    Member             @relation(fields: [memberId], references: [id])
  taskType  String // "atualizar_contato" | outros no futuro
  payload   Json
  status    MercurioSyncStatus @default(pendente)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  syncedAt  DateTime?

  @@index([memberId])
  @@index([status])
}
