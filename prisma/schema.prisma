// Schema inicial do MVP - Portal do Membro & BPO Financeiro
// Referência: protótipos demo-whatsapp.html, portal (visão do diretor).html, portal (visão do membro).html

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  em_dia
  atrasado
  negociando
  isento
}

enum ContributionStatus {
  pendente
  pago
  atrasado
}

// Status de UM mês específico, lido direto da "Ficha Anual" do Mercúrio
// (tesoura/tes_condeta.php) — granularidade mais fina que MemberStatus
// (que é 1 status geral por membro). Nomes batem com a legenda real da
// tela: EM BRANCO (ainda não cobrado), PAGA, EM ATRASO, ISENTO.
enum ContributionMonthStatus {
  em_branco
  paga
  atrasado
  isento
}

enum PaymentChargeStatus {
  pendente
  pago
  expirado
  cancelado
}

enum RecurrenceFrequency {
  diaria
  semanal
  quinzenal
  mensal
  bimestral
  semestral
  anual
}

enum ChargeTriggerType {
  inicio_mes
  dia_10_desconto // dia fixo (10) do mês, prazo do desconto de pontualidade — ver demo-whatsapp.html
  vencimento
  fim_mes
  atraso_30
  atraso_60
}

enum ClassRole {
  aluno
  professor
}

enum ActivityType {
  prova
  trabalho
  leitura
  atividade_turma
  aviso
}

enum NotificationChannel {
  whatsapp
  push
}

enum NotificationStatus {
  pendente
  enviado
  falhou
}

enum MercurioSyncStatus {
  pendente
  sincronizado
  falhou
}

model School {
  id                      String    @id @default(cuid())
  name                    String
  city                    String?
  // Idioma do Portal do Membro pra quem é dessa escola — pedido do usuário
  // 2026-10-15, pras filiais americanas vistas na Mercury API (Austin-TX,
  // Deerfield Beach, Orlando, South Orange-NJ). Decide o idioma sozinho
  // (sem seletor manual pro membro) e, por ora, esconde os fluxos de
  // pagamento (Asaas/PIX é só Brasil) pra quem está em "en" — ver
  // src/lib/i18n/.
  language                String    @default("pt") // "pt" | "en"
  // Qual sistema é a fonte da verdade dessa escola — pedido do usuário
  // 2026-10-16. "mercurio" = Mercúrio antigo, via RPA (todas as escolas do
  // Brasil hoje); "mercury" = Mercúrio novo, via API (escolas dos EUA já
  // usam). O antigo será desligado ~fev/2027: a virada é trocar este campo
  // escola por escola, sem deploy. Ver adapterParaEscola em mercurio/index.ts.
  sistemaRegistro         String    @default("mercurio") // "mercurio" | "mercury"
  // Código da unidade no banco de consulta do Mercúrio (unidades.uni_id,
  // ex: "BGA", "GYN") — chave de importação/sincronização via
  // src/lib/mercurio-db. Pedido do usuário 2026-10-18.
  mercurioUnidade         String?   @unique
  // UF da unidade (unidades.uni_uf) — eventos abertos por estado/regional.
  uf                      String?
  // Id da filial no Ulisses (eventos públicos, api.acropolebrasil.com.br/eventos/{id}).
  // Não é o código do Mercúrio: Barra do Garças = 44 ("bdg"), Sede Central = 7.
  ulissesFilialId         Int?      @unique
  // Portal liberado pra QUALQUER membro ativo dessa filial (primeiro acesso
  // por e-mail+CPF). Fora das abertas, só entram dirigentes e testadores
  // liberados por eles (ver src/lib/acesso-portal.ts).
  portalAberto            Boolean   @default(false)
  // Pagamentos e alterações que GRAVAM no Mercúrio (contribuição, composição,
  // recarga) liberados nesta filial? Pedido do usuário 2026-10-19: o
  // responsável pelo Mercúrio quer ver as consultas funcionando antes de
  // liberar a escrita; até lá só Barra do Garças, e as outras veem "em breve".
  mercurioEscrita         Boolean   @default(false)
  whatsapp                String? // número da secretaria/economia, usado no botão de ajuda do Portal
  mercurioFilialLabel     String? // texto do link "CADASTRO" da filial no Mercúrio (ex: "BARRA DO GAR" — usado como regex de match, não precisa ser exato)
  // branchId da API externa de leitura "Mercury" (ver src/lib/mercury/client.ts)
  // — id numérico da filial, mas viaja como STRING no JSON da API (ex: "4"),
  // guardado igual aqui pra nunca precisar converter/comparar tipo diferente.
  // Nada a ver com mercurioFilialLabel (que é só pro RPA, que ainda é a
  // única forma de ESCREVER no Mercúrio — a Mercury API é somente leitura).
  mercuryBranchId         String?
  createdAt               DateTime  @default(now())
  // "Diretor > Dados da Unidade" do Mercúrio (diretor/dir_frame.php) — só
  // o que alimenta o Painel do Diretor por ora (ver scripts/sync-diretoria.ts).
  // Nome do diretor/sub-chefe fica no Member (isDiretor/isSubChefe), não
  // aqui — aqui é só o que é mesmo dado da UNIDADE, não de pessoa.
  cnpj                    String?
  enderecoCompleto        String?
  telefoneUnidade         String?
  fundacao                DateTime?
  unidadeSyncedAt         DateTime?
  // Nome EXATO do caixa (Tesouraria > Caixas) usado pra lançar automaticamente
  // um recebimento de contribuição confirmado pelo Asaas (ver
  // browser-session.ts#lancarPagamentoContribuicaoHoje e
  // scripts/list-cashiers.ts pra descobrir os nomes reais antes de configurar
  // isto) — enquanto null, o lançamento automático fica desligado pra essa
  // escola (a fila só marca a tarefa como falha, nunca lança "no escuro").
  mercurioCaixaLancamento String?
  // Pedido pendente de sincronização das Rubricas de Pagamento — marcado
  // por sincronizarRubricasDePagamento (rubrica-actions.ts), processado
  // pelo worker (process-mercurio-queue.ts, já roda a cada 10min no
  // Railway) e limpo (volta a null) ao concluir. Precisou virar assíncrono
  // pra rodar no Vercel (serverless não tem Chromium/Playwright).
  rubricaSyncRequestedAt DateTime?
  // Subconta Asaas da escola (ver scripts/create-asaas-subaccount.ts) — a
  // cobrança continua sendo criada pela conta do BPO (1 API key só,
  // gerencia N escolas), e um split manda a fatia da escola pra esta
  // wallet, ficando a taxa do BPO (não informada no split) retida na
  // conta que criou a cobrança automaticamente. Enquanto null, nenhum
  // split é aplicado (100% fica na conta do BPO, comportamento antigo).
  asaasWalletId           String?
  // apiKey da PRÓPRIA subconta — só existe pra escolas onde decidimos
  // emitir a cobrança pela subconta dela mesma (não só receber o split),
  // pra que o nome mostrado ao aluno na confirmação do PIX seja o da
  // escola, não da conta raiz do BPO (regra do Banco Central: o nome
  // exibido é sempre de quem EMITE a cobrança, split não muda isso).
  // Asaas só entrega essa chave 1x, na criação da subconta — por isso
  // persistimos aqui em vez de só logar no terminal como antes.
  asaasSubaccountApiKey   String?  @db.Text

  members            Member[]
  events             Event[]
  telasEventos       TelaEventos[]
  telaCartoes        TelaCartao[]
  payables           Payable[]
  repasses           Repasse[]
  otherIncomes       OtherIncome[]
  chargingRules      ChargingRule[]
  classGroups        ClassGroup[]
  compositionCatalog SchoolCompositionCatalogItem[]
  paymentRubricas    SchoolPaymentRubrica[]
  scholasticPendencies ScholasticPendency[]
  financialSnapshots FinancialSnapshot[]
}

model Member {
  acropolePlayAccess AcropolePlayAccess?
  meetingSeriesCreated GroupMeetingSeries[]
  groupMeetingsCreated GroupMeeting[] @relation("MeetingCreator")
  meetingResponses GroupMeetingResponse[]
  meetingAuditLog GroupMeetingAudit[] @relation("MeetingAuditor")
  pushSubscriptions PushSubscription[]
  id                    String       @id @default(cuid())
  schoolId              String
  school                School       @relation(fields: [schoolId], references: [id])
  mercurioId            String?      @unique // matrícula no Mercúrio (ex: "21596"), quando conhecida
  authUserId            String?      @unique // id do usuário no Supabase Auth (login por e-mail/senha) — ver src/lib/auth.ts
  registrationNo        String? // "Matrícula #21596"
  name                  String
  whatsapp              String
  whatsappAlt           String? // "Telefone Alternativo" do Mercúrio (2º par Celular/Alternativo)
  email                 String?
  // Dependente de outro Member (ex: filho cadastrado no Mercúrio sem
  // e-mail próprio, usando o e-mail do responsável) — pedido do usuário
  // 2026-10-15: quando 2+ Members dividem o mesmo e-mail, só o responsável
  // tem login de verdade (1 e-mail = 1 conta de Auth, e authUserId já é
  // único aqui); os demais ficam vinculados aqui, sem tentar logar sozinhos.
  responsavelId         String?
  responsavel           Member?   @relation("Dependentes", fields: [responsavelId], references: [id])
  dependentes           Member[]  @relation("Dependentes")
  // Endereço estruturado (não um campo único de texto) pra permitir
  // autopreenchimento nativo do celular/Google no formulário do Portal —
  // ver src/components/member/panels/profile-edit-panel.tsx. Composto de
  // volta num Logradouro único só na hora de escrever no Mercúrio (que usa
  // 1 campo de texto livre pra rua+número+complemento), em
  // src/lib/mercurio/playwright-adapter.ts.
  addressStreet         String?
  addressNumber         String?
  addressComplement     String?
  addressNeighborhood   String?
  addressCity           String?
  addressState          String? // UF, 2 letras
  addressZip            String?
  // "Mais Dados" (aba PESSOAIS + IDENTIFICAÇÃO do Mercúrio) — ver
  // src/app/(member)/portal/mais-dados. escolaridade/estadoCivil guardam o
  // CÓDIGO que o Mercúrio usa (ex: "GRP", "SOL"), não o texto — ver
  // src/lib/mercurio/personal-data-options.ts.
  birthDate             DateTime?
  naturalidade          String? // "cidade/UF" (formato livre, como o Mercúrio grava)
  profession            String?
  escolaridade          String?
  estadoCivil           String?
  rgNumero              String?
  rgOrgaoEmissor        String?
  rgDataEmissao         DateTime?
  // Situação real no Mercúrio (ATI/INA) — sincronizada periodicamente via
  // scripts/sync-active-status.ts (lê a lista de Ativos da filial inteira
  // numa sessão só, mais eficiente que checar 1 aluno por vez). Verificado
  // no login (src/lib/auth.ts) pra impedir quem saiu da escola de manter
  // acesso ao Portal — não é uma checagem ao vivo a cada login por
  // velocidade, então pode ficar desatualizado até a próxima sincronização.
  mercurioAtivo         Boolean      @default(true)
  mercurioAtivoSync     DateTime? // última vez que este campo foi sincronizado de verdade
  // Aparece na lista "Pedagogos" (Integração > Pedagogos) de alguma filial
  // no Mercúrio — quem dá aula lá também é aluno em outras turmas, então
  // não é um papel separado no Portal, só libera o botão "Área do
  // Professor" (ver scripts/sync-pedagogos.ts e member-portal-client.tsx).
  isPedagogo            Boolean      @default(false)
  pedagogoSyncedAt      DateTime?
  // É Diretor(a) ou Sub-Chefe de alguma filial — lido de "Diretor > Dados
  // da Unidade" do Mercúrio (tem matrícula de verdade nesses dois campos,
  // diferente de Pedagogos — cruza por matrícula, não por nome). Libera o
  // card "Direção" no Portal do Voluntário (ver scripts/sync-diretoria.ts).
  isDiretor             Boolean      @default(false)
  isSubChefe            Boolean      @default(false)
  direcaoSyncedAt       DateTime?
  // Aparece em "DIRETOR > Colaboradores" (diretor/dir_unicar.php) com
  // Função contendo "ESCOLÁSTICA" — voluntário responsável pela agenda de
  // pendências acadêmicas (ex: transições pro Círculo de Amigos). Pedido do
  // usuário 2026-09-30, mesmo padrão de isPedagogo/isDiretor (sinal real do
  // Mercúrio, não bit local) — ver scripts/sync-diretoria.ts.
  isSecretarioEscolastica Boolean    @default(false)
  // Mesmo padrão acima, mas Função contendo "ECONOMIA" — aprova alterações
  // de cadastro ligadas à contribuição (pedido do usuário 2026-10-08).
  isSecretarioEconomia    Boolean    @default(false)
  // Cargos de voluntário vindos de /branches/{id}/staff da Mercury API (ex:
  // "CHEFE DE BRIGADA DE FILIAL", "COLABORADOR DE FILIAL") — texto bruto do
  // Mercúrio. Qualquer cargo aqui libera o Portal do Voluntário (pedido do
  // usuário 2026-10-15). Não concede acesso de Direção/Economia/Escolástica
  // sozinho — isso continua nos booleans acima.
  cargos                  String[]   @default([])
  // Pode liberar testadores da própria filial (diretor, chefe ou sub-chefe
  // de filial — vem do banco do Mercúrio). Liberadores nacionais ficam em
  // LiberadorNacional, não aqui.
  liberaTestadores        Boolean    @default(false)
  // Filiais (School.mercurioUnidade) em que é Chefe de Filial — pode chefiar
  // mais de uma, inclusive fora da filial da própria matrícula (ex: Izabel,
  // GYN e BGA). Ver mercurio-db/importar.ts e acesso-voluntario.ts.
  filiaisChefiadas        String[]   @default([])
  // Grupo/programa dentro da filial (PROGRAMA BRANCO > Provacionistas/
  // Membros, COMPLEMENTAR > C. de Amigos/Correntinha/Távolas/Janos) — cada
  // um é uma listagem própria no Mercúrio (mesmo formato Matr./Nome de
  // Ativos), sincronizada por scripts/sync-perfil-grupos.ts. Pedido do
  // usuário 2026-10-08: usado pra limitar quais rubricas de contribuição
  // aparecem pra cada membro (ver rubrica-visibilidade.ts) — ex: a rubrica
  // "CONTRIBUIÇÃO JANOS" só deve aparecer pra quem tem isJanos=true. Não é
  // mutuamente exclusivo (uma pessoa pode, em teoria, aparecer em mais de
  // uma lista) — por isso são booleans separados, não um enum único.
  isProvacionista       Boolean      @default(false)
  isMembroPrograma      Boolean      @default(false)
  // Público dos eventos (pedido do usuário 2026-10-19), vindos do Mercúrio:
  // nível (cad_nivel: N1…N9, PP, CA…), HD (cad_machado HDA/HDR), dirigente
  // (cad_dirigente 'S') e FV/brigadista (cad_situacao_fv 'BRG').
  nivel                 String?
  isHD                  Boolean      @default(false)
  isDirigente           Boolean      @default(false)
  isFV                  Boolean      @default(false)
  // Em provacionismo para o FV (cad_situacao_fv 'PRO') — o público
  // "Provacionistas" dos eventos. Diferente de isProvacionista (nível PP).
  emProvacionismo       Boolean      @default(false)
  isCirculoDeAmigos     Boolean      @default(false)
  isCorrentinha         Boolean      @default(false)
  isTavolas             Boolean      @default(false)
  isJanos               Boolean      @default(false)
  perfilGruposSyncedAt  DateTime?
  // Id do cliente na carteira digital Fortuna (oinabnfortuna.acropolebrasil.com.br)
  // — numeração própria, SEM relação com mercurioId. Resolvido 1x por
  // e-mail/telefone (scripts/link-fortuna-client.ts), não por nome (mais
  // confiável que o casamento por nome que o Mercúrio exige). Diferente do
  // Mercúrio, a API do Fortuna é rápida (REST normal, sem RPA) — o saldo é
  // lido ao vivo a cada carregamento do Portal, não sincronizado/cacheado.
  fortunaClientId       Int?         @unique
  // Valor fixo mensal de crédito Fortuna cobrado JUNTO de toda cobrança
  // futura (manual ou automática via Pix Automático) — pedido do usuário
  // 2026-10-08, oferecido como nudge (ver nudge-actions.ts). Null = sem
  // recorrência (comportamento de sempre); quando preenchido,
  // process-pix-automatico.ts soma isso no ciclo automático e
  // PaymentCharge.fortunaTopUpAmount credita na confirmação (mesmo
  // mecanismo já usado pro avulso).
  fortunaTopUpRecorrente Decimal?    @db.Decimal(10, 2)
  nudgeStates           MemberNudgeState[]
  status                MemberStatus @default(em_dia)
  createdAt             DateTime     @default(now())
  // "Anotações Econômicas sobre o Aluno" — textarea da tela de Composição
  // das Contribuições no Mercúrio (campo txtobs, limite de 255 caracteres
  // lá). Igual ao contato/dados pessoais: escreve local na hora e só
  // enfileira a propagação pro Mercúrio (ver sync-queue.ts) — worker
  // separado processa em background (scripts/process-mercurio-queue.ts).
  economicNotes         String?      @db.VarChar(255)
  economicNotesSyncedAt DateTime?

  // Pix Automático (Asaas, lançado maio/2026) — autorização de débito
  // recorrente de verdade: o aluno autoriza 1x (paga o 1º QR code) e os
  // ciclos seguintes são cobrados automaticamente pelo worker mensal (ver
  // scripts/sync-monthly-status.ts e pix-automatico-actions.ts), sem
  // precisar abrir o Portal de novo — decisão do usuário 2026-09-22: vira o
  // padrão SUGERIDO (empurrado ativamente após o 1º pagamento manual), mas
  // continua opcional. `asaasCustomerId` persistido aqui (diferente do
  // fluxo avulso de createContributionCharge, que resolve por CPF toda vez)
  // porque o worker precisa cobrar sem o aluno digitar o CPF de novo.
  asaasCustomerId             String?
  pixAutomaticAuthorizationId String?
  // Espelha o status da autorização no Asaas: CREATED | ACTIVE | CANCELLED
  // | REFUSED | EXPIRED — atualizado via webhook (evento
  // PIX_AUTOMATIC_RECURRING_AUTHORIZATION_*) e por polling de fallback.
  pixAutomaticStatus          String?
  pixAutomaticActivatedAt     DateTime?

  // Tour guiado do 1º login (ver onboarding-tour.tsx) — null = ainda não
  // viu. Decisão do usuário 2026-09-28.
  tourCompletedAt DateTime?
  // Data real de entrada na escola, pra Jornada Filosófica — não achamos
  // fonte confiável no Mercúrio pra isso ainda, então por ora é só
  // preenchimento manual pelo diretor (ver member-detail-panel.tsx). Se
  // ficar null, a jornada usa createdAt (quando entrou no Portal) como
  // aproximação, deixando claro que é uma estimativa.
  dataEntradaEscola DateTime?
  // Data real da passagem pro 2º nível (cadastro.cad_2o_nivel no banco do
  // Mercúrio) — marco da Jornada. Pedido do usuário 2026-10-18.
  dataSegundoNivel  DateTime?
  // Foto de perfil (Supabase Storage, bucket privado "member-avatars" — ver
  // profile-actions.ts) — pedido do usuário 2026-09-30: deixa o Portal
  // mais pessoal e ajuda a diretoria a reconhecer quem é quem.
  avatarPath        String?

  contributions           Contribution[]
  compositionItems        ContributionCompositionItem[]
  compositionRequests     CompositionChangeRequest[]
  receipts                ContributionReceipt[]
  monthlyStatus           ContributionMonthlyStatus[]
  fortunaTx               FortunaTransaction[]
  crmContacts             CrmContact[]
  gafRequests             GafRequest[]
  badges                  MemberBadge[]
  levelHistory            MemberLevelHistory[]
  integrationCourses      MemberIntegrationCourse[]
  scholasticPendencies    ScholasticPendency[]
  volunteerOffers         VolunteerOffer[]
  eventRegistr            EventRegistration[]
  classMemberships        ClassMembership[]
  createdActivities       Activity[]                    @relation("ActivityCreator")
  activityNotifs          ActivityNotification[]
  contactChangeLogs       ContactChangeLog[]
  mercurioSyncTasks       MercurioSyncTask[]
  agendaReactions         AgendaReaction[]
  createdPolls            Poll[]                        @relation("PollCreator")
  pollVotes               PollVote[]
  volunteerTermSignatures VolunteerTermSignature[]
  paymentCharges          PaymentCharge[]
  fortunaTopUpCharges     FortunaTopUpCharge[]
  chargeMessageDrafts     ChargeMessageDraft[]

  @@index([schoolId])
}

model Contribution {
  id         String             @id @default(cuid())
  memberId   String
  member     Member             @relation(fields: [memberId], references: [id])
  amount     Decimal            @db.Decimal(10, 2)
  dueDate    DateTime
  paidAt     DateTime?
  status     ContributionStatus @default(pendente)
  gatewayRef String? // id da cobrança no Asaas
  createdAt  DateTime           @default(now())

  @@index([memberId])
}

// ===================== Composição das Contribuições =====================
// Espelha a tela "Composição das Contribuições" do Mercúrio
// (tesoura/tes_conedit.php) — a lista de itens que somados formam a
// mensalidade do membro (ex: CONTRIBUIÇÃO BIBLIOTECA, CC FILIAL, DIRIGENTE...).
// mercurioGroupId é o "grp" da URL de lá — identifica o item de verdade,
// usado pra editar/excluir no Mercúrio. addedViaPortal marca o que o
// PRÓPRIO membro incluiu pelo Portal — regra de negócio explícita: só
// esses podem ser editados/excluídos por ele; itens que já vieram do
// Mercúrio (lançados pela tesouraria) são só leitura no Portal.
model ContributionCompositionItem {
  id                String                     @id @default(cuid())
  memberId          String
  member            Member                     @relation(fields: [memberId], references: [id])
  mercurioGroupId   String // "grp" no Mercúrio
  label             String // "CONTRIBUIÇÃO BIBLIOTECA"
  amount            Decimal                    @db.Decimal(10, 2)
  addedViaPortal    Boolean                    @default(false)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  removalRequests   CompositionChangeRequest[]

  @@unique([memberId, mercurioGroupId])
  @@index([memberId])
}

// Pedido do usuário 2026-10-08: incluir um item NOVO de composição (cria um
// compromisso financeiro que a escola ainda não sabe que existe) passa a
// exigir aprovação do Secretário de Economia — mesmo espírito do
// ContactChangeLog pro Cadastro, mas em modelo próprio porque aqui não há
// "valor antigo" (é sempre inclusão, nunca edição). Editar/remover um item
// que o próprio membro já incluiu continua self-service (ver
// contribution-actions.ts) — baixo risco, já tem a trava de
// addedViaPortal. Doação é exceção à inclusão (ver solicitarItemComposicao):
// aplica direto, sem passar por aqui.
//
// Também cobre REMOÇÃO (tipo="remocao", pedido do usuário 2026-10-08): tirar
// um item que a ESCOLA lançou direto no Mercúrio (addedViaPortal=false) não é
// self-service — vira pedido aqui também, referenciando compositionItemId. O
// item continua existindo normalmente até a aprovação.
model CompositionChangeRequest {
  id                String                    @id @default(cuid())
  memberId          String
  member            Member                    @relation(fields: [memberId], references: [id])
  tipo              String                    @default("inclusao") // "inclusao" | "remocao" | "reducao"
  compositionItemId String? // só em "remocao" — item de verdade que será removido se aprovado
  compositionItem   ContributionCompositionItem? @relation(fields: [compositionItemId], references: [id])
  mercurioGroupId   String
  label             String
  amount            Decimal                   @db.Decimal(10, 2)
  // "reducao" (pedido do usuário 2026-10-19: diminuir valor exige aprovação): amount = valor novo, previousAmount = valor atual.
  previousAmount    Decimal?                  @db.Decimal(10, 2)
  status            String                    @default("pendente") // "pendente" | "aprovado" | "rejeitado"
  reviewedAt        DateTime?
  createdAt         DateTime                  @default(now())

  @@index([memberId])
}

// Pedido do usuário 2026-10-08: estado de "nudge" de contribuição extra
// (crédito recorrente no Fortuna, doação Biblioteca, Criança pelo Bem — ver
// catálogo fixo em nudge-actions.ts) por membro, pra não repetir uma
// sugestão que ele já adiou ou recusou. "adiado" só esconde até
// snoozedUntil (1º dia do mês seguinte); "recusado" esconde pra sempre.
model MemberNudgeState {
  id           String    @id @default(cuid())
  memberId     String
  member       Member    @relation(fields: [memberId], references: [id])
  suggestionId String // chave fixa do catálogo, ex: "fortuna-recorrente"
  status       String // "adiado" | "recusado"
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([memberId, suggestionId])
}

// Catálogo de tipos de rubrica ("Itens de Contribuição") de uma filial,
// sincronizado periodicamente (scripts/sync-composition.ts) em vez de lido
// ao vivo a cada clique no Portal — na prática são poucos tipos fixos por
// filial (ex: CONTRIBUIÇÃO BIBLIOTECA, CC FILIAL, DIRIGENTE) que quase nunca
// mudam. "Disponível pra incluir" pra um membro específico = este catálogo
// menos os mercurioGroupId que ele já tem em ContributionCompositionItem.
model SchoolCompositionCatalogItem {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  mercurioGroupId String
  label           String
  syncedAt        DateTime @default(now())

  @@unique([schoolId, mercurioGroupId])
  @@index([schoolId])
}

// Comprovantes reais de pagamento (recibos de caixa emitidos pela
// tesouraria — tesoura/tes_cailstr.php + tes_conprt.php no Mercúrio).
// A LISTA (mercurioRecId, issuedAt, amount, probablyCanceled) vem de uma
// sincronização em lote por escola (scripts/sync-receipts.ts, varre a
// listagem mensal — barata, não abre o documento de cada recibo). O
// CONTEÚDO (rawText) só é buscado sob demanda, na primeira vez que o
// membro pede pra ver/baixar um recibo específico (fila MercurioSyncTask,
// taskType "buscar_recibo") — e cacheado pra sempre depois, porque um
// recibo já emitido é um documento histórico imutável (só pode ser
// cancelado, nunca alterado).
model ContributionReceipt {
  id               String    @id @default(cuid())
  memberId         String
  member           Member    @relation(fields: [memberId], references: [id])
  mercurioRecId    String    @unique // "rec" no Mercúrio (ex: "1346179")
  issuedAt         DateTime
  amount           Decimal   @db.Decimal(10, 2)
  // Heurística da listagem (linha sem o link "Cancela") — só pré-triagem,
  // não é definitiva (ver nota em browser-session.ts:lerRecibosDoMes).
  probablyCanceled Boolean   @default(false)
  rawText          String?   @db.Text
  // Rótulo curto derivado do rawText (ex: "CONTRIBUIÇÃO BIBLIOTECA +5
  // itens") — mostrado na lista antes do membro abrir o comprovante. Ver
  // extrairRubricaSimplificada em browser-session.ts.
  itemsSummary     String?
  // null = conteúdo nunca buscado, ainda não confirmado. true/false =
  // confirmado de verdade ao ler o documento (tem/não tem "CANCELADO").
  canceled         Boolean?
  fetchedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([memberId])
}

// Status mensal real da contribuição, sincronizado da Ficha Anual do
// Mercúrio (scripts/sync-monthly-status.ts) — diferente da Composição
// (que são as RUBRICAS que compõem o valor mensal) e dos Recibos (que são
// os PAGAMENTOS já emitidos): esta é a grade PAGA/EM BRANCO/EM
// ATRASO/ISENTO mês a mês que alimenta a tela "situação atual" do Portal
// (ambiente de pagamento — cobrança real e lançamento no Mercúrio ainda
// não implementados, ver histórico de conversa).
model ContributionMonthlyStatus {
  id             String                  @id @default(cuid())
  memberId       String
  member         Member                  @relation(fields: [memberId], references: [id])
  year           Int
  month          Int // 1-12
  status         ContributionMonthStatus
  registeredAtBR String? // data de registro do pagamento, formato dd/mm/yyyy como o Mercúrio grava
  registeredBy   String? // "Responsável" na Ficha Anual — quem lançou o pagamento
  mercurioRecId  String? // liga com ContributionReceipt.mercurioRecId quando o mês tem recibo
  syncedAt       DateTime                @default(now())

  @@unique([memberId, year, month])
  @@index([memberId])
}

// Cobrança PIX real via Asaas (gateway de pagamento) pra 1 mês de
// contribuição. CPF é pedido na hora do pagamento e passado direto pro
// Asaas — não fica guardado aqui, mesma lógica de minimização já usada
// pra derivar a senha inicial de login a partir do CPF do Mercúrio.
// Confirmação de pagamento vem por webhook (rota /api/webhooks/asaas) OU
// polling (checkChargeStatus) — o que chegar primeiro marca `pago` e
// enfileira o lançamento no Mercúrio (MercurioSyncTask).
model PaymentCharge {
  id              String              @id @default(cuid())
  memberId        String
  member          Member              @relation(fields: [memberId], references: [id])
  referenceYear   Int
  referenceMonth  Int
  amount          Decimal             @db.Decimal(10, 2)
  status          PaymentChargeStatus @default(pendente)
  asaasCustomerId String
  asaasPaymentId  String              @unique
  // "PIX" (padrão) ou "CREDIT_CARD" — decide se pixPayload/pixQrCodeBase64
  // (embutido na tela) ou invoiceUrl (checkout hospedado pelo Asaas, evita
  // qualquer dado de cartão passar pelo nosso servidor) é o campo relevante.
  billingType     String              @default("PIX")
  pixPayload      String?             @db.Text
  pixQrCodeBase64 String?             @db.Text
  invoiceUrl      String?             @db.Text
  // Sobretaxa do cartão (repassada ao aluno — decisão do usuário em
  // 2026-09-22) somada em cima do `amount` real da contribuição pra cobrir
  // a taxa do Asaas (bem mais alta que a do PIX) — não é receita real, só
  // referência pra mostrar "valor + taxa do cartão" na tela.
  cardSurcharge   Decimal?            @db.Decimal(10, 2)
  // Recarga Fortuna combinada na MESMA cobrança da contribuição (decisão do
  // usuário 2026-09-22: aproveitar o momento em que o aluno já está pagando
  // pra sugerir também recarregar, sem precisar de um 2º PIX/cartão) — ver
  // confirm-payment.ts, que credita isso automaticamente junto da
  // confirmação, igual ao fluxo já existente em fortuna-topup-actions.ts.
  fortunaTopUpAmount     Decimal?     @db.Decimal(10, 2)
  fortunaTopUpLaunchedAt DateTime?
  fortunaTopUpLaunchedBy String?
  fortunaTopUpError      String?      @db.Text
  // true = gerada sozinha pelo worker contra uma autorização Pix Automático
  // ativa (ver pix-automatico-actions.ts), sem o aluno ter feito nada —
  // só pra transparência no Painel do Diretor (distinguir de cobrança
  // manual criada quando o aluno clicou em "pagar").
  autoDebito             Boolean      @default(false)
  // Snapshot do Member.status NA HORA em que esta cobrança foi criada —
  // pedido do usuário 2026-10-08: "reversão de inadimplência" (ver
  // getCrescimentoContribuicoes em economia-actions.ts) é a soma de
  // cobranças PAGAS que foram criadas enquanto o membro estava "atrasado"
  // ou "negociando". Não dá pra inferir isso depois pelo status atual
  // (ele já mudou pra "em_dia" assim que pagou) — precisa do snapshot.
  memberWasOverdue Boolean      @default(false)
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([memberId])
}

// Recarga da carteira Fortuna via PIX real (Asaas). Confirmado ao vivo em
// 2026-09-21 (DevTools na sessão real da tesouraria) que o Fortuna TEM um
// endpoint de escrita real — PUT /balance/with-receipt — então o crédito é
// automático (ver fortunaCreditarSaldo em fortuna/client.ts), chamado assim
// que o polling detecta o PIX pago. `launchedAt`/`launchedBy`/
// `autoCreditError` só existem pro caso de FALHA do crédito automático
// (ex: membro sem fortunaClientId vinculado, API fora do ar) — nesse caso a
// cobrança cai numa fila de exceção na FortunaTab pra lançamento manual.
model FortunaTopUpCharge {
  id              String              @id @default(cuid())
  memberId        String
  member          Member              @relation(fields: [memberId], references: [id])
  amount          Decimal             @db.Decimal(10, 2)
  branchId        Int
  status          PaymentChargeStatus @default(pendente)
  asaasCustomerId String
  asaasPaymentId  String              @unique
  pixPayload      String?             @db.Text
  pixQrCodeBase64 String?             @db.Text
  paidAt          DateTime?
  launchedAt      DateTime?
  launchedBy      String?
  autoCreditError String?             @db.Text
  createdAt       DateTime            @default(now())

  @@index([memberId])
}

model FortunaTransaction {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  amount    Decimal  @db.Decimal(10, 2) // positivo = recarga, negativo = consumo
  type      String // recarga | consumo
  note      String?
  createdAt DateTime @default(now())

  @@index([memberId])
}

// Log de tentativas de negociação com membro inadimplente. O registro mais
// recente SEM resolvedAt de um membro representa a negociação em aberto
// (ver RecuperacaoTab) — não é 1 registro fixo por negociação, é histórico
// de contatos, e o último aberto que conta.
model CrmContact {
  id                  String    @id @default(cuid())
  memberId            String
  member              Member    @relation(fields: [memberId], references: [id])
  channel             String // whatsapp | telefone | presencial
  hadReply            Boolean   @default(false)
  notes               String?
  promisedPaymentDate DateTime?
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([memberId])
}

// ===================== GAF / Voluntariado =====================
// Bug real encontrado 2026-09-22: os botões "Solicitar adesão ao GAF" e "Me
// oferecer para apoiar" (misc-panels.tsx) só mudavam um estado local do
// React — nada era salvo, ninguém na escola via o pedido. Agora persiste de
// verdade e aparece no detalhe do membro no Painel do Diretor.
model GafRequest {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  createdAt DateTime @default(now())

  @@index([memberId])
}

model VolunteerOffer {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  secretarias String[] // ex: ["Economia", "Difusão"] — ver SECRETARIAS em misc-panels.tsx
  createdAt   DateTime @default(now())

  @@index([memberId])
}

// ===================== Gamificação / Jornada Filosófica =====================
// Decisão do usuário 2026-09-28: conquistas/selos incentivam sem
// discriminar quem está em atraso (diferente da ideia descartada de
// conteúdo exclusivo pra quem paga em dia) — catálogo de tipos vive em
// código (src/lib/badges.ts), aqui só guarda QUANDO cada membro conquistou
// cada um, permanentemente (não some se a condição deixar de valer depois).
model MemberBadge {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  badgeType String
  earnedAt  DateTime @default(now())

  @@unique([memberId, badgeType])
  @@index([memberId])
}

// Histórico de mudança de nível (Mercúrio expõe esse campo na tela de
// Fichas — tesoura/tes_conficha.php — mas era descartado até agora, ver
// sync-monthly-status.ts). Usado na Jornada Filosófica pra mostrar quando
// o membro passou pro 2º nível etc. Só existe registro a partir de quando
// começamos a capturar (2026-09-28 em diante) — não dá pra saber
// retroativamente a data exata de mudanças passadas.
model MemberLevelHistory {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  nivel     String
  changedAt DateTime @default(now())

  @@index([memberId])
}

// Cursos de Formação e Integração (aba "CURSOS INTEGRAÇÃO" da ficha do
// aluno no Mercúrio, unidade/uni_dircur.php?matr=X) — fonte indicada pelo
// usuário 2026-09-30 pra completar a Jornada Filosófica. O Mercúrio não
// expõe um id estável por curso (só a tabela Curso/Data/Instrutor), então a
// unicidade é pelo conjunto dos 3 campos — sincronizado junto com a
// composição (ver scripts/sync-composition.ts), já que ambos exigem abrir a
// ficha do aluno na mesma sessão.
model MemberIntegrationCourse {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  courseName String
  dateBR     String // "dd/mm/aaaa" como o Mercúrio exibe
  courseDate DateTime? // dateBR convertido, pra ordenar a timeline — null se a data vier num formato inesperado
  instructor String
  syncedAt   DateTime @default(now())

  @@unique([memberId, courseName, dateBR])
  @@index([memberId])
}

// Agenda de pendências do Secretário de Escolástica — pedido do usuário
// 2026-09-30 (caso real: Glaubia Rocha Barbosa Relvas, que precisa ser
// incluída no Círculo de Amigos no Mercúrio numa data futura). Por ora é só
// lembrete manual (ver conversa: não achamos, explorando ao vivo, a tela do
// Mercúrio que executa "incluir no Círculo de Amigos" pra automatizar com
// segurança) — `tipo` já vem com um valor conhecido ("inclusao_circulo_amigos",
// "baixa_membro") pra facilitar filtrar/automatizar depois, se a tela certa
// for encontrada.
model ScholasticPendency {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  memberId    String?
  member      Member?   @relation(fields: [memberId], references: [id])
  tipo        String
  title       String
  notes       String?
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([memberId])
}

// Snapshot cacheado da Transparência Financeira — pedido do usuário
// 2026-09-30: (a) parar de recalcular a cada clique de membro (todos da
// escola devem ver o MESMO número, vindo do mesmo lugar); (b) só existe
// pra mês já FECHADO (mês corrente nunca tem snapshot — ver
// transparency-data.ts). Gerado por scripts/sync-financial-snapshot.ts a
// partir do relatório real "Movimento do Período" do Mercúrio (Tesouraria >
// Movimento > Sintético), não mais de tabelas locais (Payable/OFX
// dependiam de upload manual de extrato, que nem sempre acontece).
model FinancialSnapshot {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id])
  ano         Int
  mes         Int
  payload     Json
  generatedAt DateTime @default(now())

  @@unique([schoolId, ano, mes])
  @@index([schoolId])
}

model ChargingRule {
  id       String          @id @default(cuid())
  schoolId String
  school   School          @relation(fields: [schoolId], references: [id])
  name     String // "Régua Padrão", "Régua Suave", "Régua de Resgate"
  triggers ChargeTrigger[]

  @@index([schoolId])
}

model ChargeTrigger {
  id              String            @id @default(cuid())
  chargingRuleId  String
  chargingRule    ChargingRule      @relation(fields: [chargingRuleId], references: [id])
  type            ChargeTriggerType
  active          Boolean           @default(true)
  messageTemplate String            @db.Text

  drafts ChargeMessageDraft[]

  @@index([chargingRuleId])
}

enum ChargeMessageStatus {
  pendente_aprovacao
  aprovado
  enviado
  descartado
}

// Rascunho de mensagem de cobrança gerado a partir de um gatilho — fica
// pendente de aprovação manual do diretor antes de enviar de verdade (ver
// discussão: disparo automático real não foi autorizado, só fila revisada
// à mão). @@unique com cycleKey evita gerar 2x a mesma cobrança pro mesmo
// membro/gatilho no mesmo ciclo (ex: "2026-09") a cada vez que a tela roda
// a geração.
model ChargeMessageDraft {
  id              String              @id @default(cuid())
  memberId        String
  member          Member              @relation(fields: [memberId], references: [id])
  chargeTriggerId String
  chargeTrigger   ChargeTrigger       @relation(fields: [chargeTriggerId], references: [id])
  cycleKey        String // "aaaa-mm" do momento em que foi gerado
  channel         String              @default("whatsapp")
  body            String              @db.Text
  status          ChargeMessageStatus @default(pendente_aprovacao)
  createdAt       DateTime            @default(now())
  decidedAt       DateTime?

  @@unique([memberId, chargeTriggerId, cycleKey])
  @@index([memberId])
}

enum AgendaItemType {
  evento
  atividade
}

// Reação com emoji num item da Agenda (Event OU Activity — ver
// AgendaItem.kind em member-data.ts). Sem FK pra itemId de propósito: um
// único modelo cobre os dois tipos em vez de duplicar tudo pra
// EventReaction/ActivityReaction. Visível pra outros alunos da mesma
// turma/escola (agregado por emoji, sem expor quem reagiu).
model AgendaReaction {
  id        String         @id @default(cuid())
  itemType  AgendaItemType
  itemId    String
  memberId  String
  member    Member         @relation(fields: [memberId], references: [id])
  emoji     String
  createdAt DateTime       @default(now())

  @@unique([itemType, itemId, memberId, emoji])
  @@index([itemType, itemId])
}

// Eventos internos usam público explícito e o vínculo real com a filial.
// Fontes externas mantêm sua inscrição na origem. Ágora aguarda mapeamento
// oficial de papéis e é bloqueado por padrão no Portal.
model Event {
  id          String    @id @default(cuid())
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id])
  scope       String    @default("filial") // "nacional" | "regional" | "filial"
  title       String
  description String?   @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime?
  allDay      Boolean   @default(false)
  price       Decimal   @default(0) @db.Decimal(10, 2)
  // "manual" (Diretor cria em EventosTab) | "google_calendar_nacional"
  // (importado — ver sync-national-calendar.ts, nunca editar à mão um
  // evento com esse source, o próximo sync sobrescreve).
  source      String    @default("manual")
  // UID do VEVENT no Google Calendar — dedupe no re-sync (upsert por
  // isso, não cria de novo a cada rodada). Só existe em source=
  // "google_calendar_nacional". Eventos recorrentes (RRULE) viram uma
  // linha por ocorrência, UID sufixado com a data (ver script).
  externalUid String?   @unique
  createdAt   DateTime  @default(now())

  posterPath String?
  capacity Int?
  registrationClosesAt DateTime?
  participantInstructions String? @db.Text
  contactInfo String?
  audience String @default("todos_ativos")
  // Vários públicos ao mesmo tempo (2026-10-19): todos_ativos, membros, fv,
  // provacionistas, hd, dirigentes. "audience" fica com o primeiro, por compatibilidade.
  publicos String[] @default([])
  // Inscrições de outras filiais: "filial" (só a dona), "todas", "filiais"
  // (ids em abertoValores), "regionais" (centro_oeste, df, nordeste, norte) ou
  // "estados" (UFs).
  abertoA       String   @default("filial")
  abertoValores String[] @default([])
  // Lanche compartilhado (pedido do usuário 2026-10-21): cada um leva algo; aparece em destaque no evento.
  lancheCompartilhado Boolean @default(false)
  // Post oficial do evento no Instagram (pedido do usuário 2026-10-22): compartilhar o post
  // oficial em vez de criar outro. Preenchido na administração; a importação do Ulisses não mexe.
  linkPostagemOficial String?
  // Leitura do cartaz por IA (pedido do usuário 2026-10-22): o que já está escrito nele
  // ({data, horario, local, inscricao}: boolean). Feita uma vez por imagem, guardada aqui e
  // usada por todos que compartilharem; cartazLidoUrl diz qual imagem foi lida.
  cartazLeitura Json?
  cartazLidoUrl String?
  // Resumo da descrição para as telas de TV, feito por IA (pedido do usuário 2026-10-24);
  // resumoTelaDe = impressão da descrição resumida (lib/resumo-tela.ts).
  resumoTela   String?
  resumoTelaDe String?
  // Desistência paga com devolução até N dias antes do evento (pedido do usuário
  // 2026-10-22: padrão 3; opções 1, 3 ou 7; null = sem devolução).
  prazoDesistenciaDias Int? @default(3)
  status String @default("publicado")
  registrationUrl String?
  // Imagem pública do evento no Ulisses (https). Cartaz próprio da filial fica em posterPath.
  imageUrl String?
  revision Int @default(0)
  refundOnCancellation Boolean @default(false)
  staff EventReception[]
  audits EventAudit[]
  registrations EventRegistration[]

  @@index([schoolId])
  @@index([scope])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  paid      Boolean  @default(false)
  checkedIn Boolean  @default(false)
  createdAt DateTime @default(now())

  // Pagamento real via Asaas (PIX) — decisão do usuário 2026-09-30:
  // inscrição em evento pelo próprio Portal, igual ao fluxo de
  // contribuição. null = evento gratuito (paid=true direto, nada a
  // cobrar) ou inscrição lançada pela secretaria sem cobrança própria.
  asaasCustomerId String?
  asaasPaymentId  String?   @unique
  pixPayload      String?   @db.Text
  pixQrCodeBase64 String?   @db.Text
  paidAt          DateTime?
  checkedInAt DateTime?
  checkedInBy String?
  selfReportedAttendance String?
  selfReportedAt DateTime?
  // Desistência do próprio aluno (2026-10-22): a inscrição para de ocupar vaga e,
  // se paga dentro do prazo, entra na fila de reembolso (event-refunds.ts).
  desistenciaEm DateTime?
  mercurioStatus String @default("aguardando_integracao")
  paymentState String @default("novo")
  amount Decimal? @db.Decimal(10,2)
  refundState String @default("nao_solicitado")
  refundSubmittedAt DateTime?
  refundCheckedAt DateTime?
  refundNextAttemptAt DateTime?
  refundLeaseUntil DateTime?
  refundLockId String?
  refundAttempts Int @default(0)
  refundError String?
  refundedAmount Decimal @default(0) @db.Decimal(10,2)
  refundedAt DateTime?
  refundsSnapshot Json @default("[]")
  mercurioReceiptNo String?
  mercurioRecordedAt DateTime?
  mercurioRecordedBy String?
  notices EventNotice[]

  @@unique([eventId, memberId])
  @@index([eventId])
  @@index([memberId])
}

model Payable {
  id                  String                @id @default(cuid())
  schoolId            String
  school              School                @relation(fields: [schoolId], references: [id])
  vendor              String
  amount              Decimal               @db.Decimal(10, 2)
  dueDate             DateTime
  hasInvoice          Boolean               @default(false)
  paidAt              DateTime?
  createdAt           DateTime              @default(now())
  // Id da transação no extrato OFX (FITID) — dedupe: reimportar o mesmo
  // extrato (ou um período que se sobrepõe) nunca duplica a conta. Só
  // presente em contas que vieram de importação de extrato.
  bankFitId           String?               @unique
  // Conta prevista automaticamente (por padrão detectado no extrato OU
  // porque é filha de uma conta marcada `recurring`) — ver
  // bank-import-actions.ts e repasse-actions.ts. Ainda não é um pagamento
  // real, só uma previsão editável/removível pelo diretor.
  predicted           Boolean               @default(false)
  // Conta recorrente marcada explicitamente pelo diretor na criação — ao
  // criar ou ao marcar como paga, gera automaticamente a PRÓXIMA
  // ocorrência (predicted:true, recurring:true + mesma frequência, pra
  // continuar a cadeia). frequency é null quando recurring=false.
  recurring           Boolean               @default(false)
  recurrenceFrequency RecurrenceFrequency?
  // Categoria de despesa conciliada contra o catálogo real do Mercúrio
  // (Tesouraria > Caixa > Pagamento Outros > select "Rubrica", mesmo usado
  // pela ferramenta irmã C:\Scrapper\mercurio-tesouraria pra lançamento
  // automático — ver SchoolPaymentRubrica/rubrica-actions.ts). Null =
  // ainda não conciliada.
  rubricaId           String?
  rubrica             SchoolPaymentRubrica? @relation(fields: [rubricaId], references: [id])

  documents AccountantDocument[]

  @@index([schoolId])
  @@index([rubricaId])
}

// Catálogo de Rubricas de Pagamento da filial, sincronizado ao vivo do
// Mercúrio (Tesouraria > Caixa > dia > "Pagamento Outros" > select
// cmbrub) — ver lerRubricasDePagamento em browser-session.ts. Mesmo
// catálogo que a ferramenta irmã C:\Scrapper\mercurio-tesouraria usa pra
// lançamento automático de despesa.
model SchoolPaymentRubrica {
  id                String   @id @default(cuid())
  schoolId          String
  school            School   @relation(fields: [schoolId], references: [id])
  mercurioRubricaId String
  label             String
  syncedAt          DateTime @default(now())

  payables Payable[]

  @@unique([schoolId, mercurioRubricaId])
  @@index([schoolId])
}

// Registro MANUAL de repasse (a fatia que sai da conta do BPO — que criou
// a cobrança PIX real com split, ver PERCENTUAL_SPLIT_ESCOLA em
// payment-actions.ts — e chega na subconta Asaas da escola). Decisão
// explícita do usuário: registro próprio no banco, não leitura em tempo
// real da API do Asaas (não existe endpoint de extrato/transferência
// chamado hoje). Um mês pode ter mais de 1 repasse (parcial), por isso sem
// @@unique em (schoolId, referenceYear, referenceMonth).
// Repasse — decisão explícita do usuário (2026-09-18): NÃO fica visível
// pro diretor da escola (é a remuneração do BPO/split, não faz parte do
// que a escola precisa acompanhar) — o model/action continuam existindo
// pra um painel interno futuro do BPO, só a aba "Contas e Conciliações" do
// Painel do Diretor deixou de mostrar isso.
model Repasse {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  amount         Decimal  @db.Decimal(10, 2)
  referenceYear  Int
  referenceMonth Int
  note           String?
  registeredAt   DateTime @default(now())

  @@index([schoolId])
}

// Receita que não passa pelo Portal (livraria, cursos avulsos, doações
// etc — ver finance-categories.ts) — lançamento manual do diretor, pra
// alimentar a Transparência Financeira (contribuições e eventos já são
// medidos automaticamente, isso cobre o resto). Decisão do usuário
// 2026-09-30.
model OtherIncome {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  category   String
  amount     Decimal  @db.Decimal(10, 2)
  receivedAt DateTime
  note       String?
  createdAt  DateTime @default(now())

  @@index([schoolId])
}

// Recibo/NF que o diretor cadastra pra enviar ao contador mensalmente —
// arquivo real guardado no Supabase Storage (bucket "contador-docs",
// privado — ver accountant-actions.ts), aqui só o caminho + metadados.
// Recibo/NF anexado DIRETO na conta a pagar correspondente (não numa área
// solta) — decisão explícita do usuário: evita conciliar o documento
// errado com o pagamento errado. 1 Payable pode ter mais de 1 documento
// (ex: NF + recibo de pagamento).
model AccountantDocument {
  id         String   @id @default(cuid())
  payableId  String
  payable    Payable  @relation(fields: [payableId], references: [id])
  title      String
  filePath   String
  uploadedAt DateTime @default(now())

  @@index([payableId])
}

// ===================== Turmas, Professores e Agenda =====================
// Fonte de verdade da matrícula/papel (aluno x professor) é o Mercúrio;
// aqui replicamos o necessário para orientar a UI e permitir o cadastro
// de atividades mesmo antes de fechar o formato exato da integração.

model ClassGroup {
  id              String   @id @default(cuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  name            String // "Curso de Filosofia - Turma A"
  // Nome da turma tal como aparece na Escala de Professores do Mercúrio
  // (ex: "HILARION", "AMON") — sabemos o formato agora (ver
  // scripts/sync-teacher-classes.ts), diferente do comentário antigo.
  mercurioClassId String?
  // "turma" (padrão) ou grupo de voluntários vindo do cadastro do Mercúrio
  // (cad_raio_fv): "BF" Brigada Feminina, "BM" Brigada Masculina, "CS"
  // Corpo de Segurança. Nos grupos, role "professor" = chefe/responsável e
  // "aluno" = integrante (BRG). Ver mercurio-db/importar.ts.
  tipo            String   @default("turma")
  // Canal do Slack da filial vinculado ao grupo (opcional) — ver lib/slack.ts.
  slackChannelId  String?
  slackTeamId     String?
  // Grupos montados no Portal (pedido do usuário 2026-10-19): "GAF" (Grupo de
  // Acompanhamento Filosófico, criado pela administração da filial), "GDVE"
  // (criado por FV, só FV selecionados) e "SEC" (secretaria da filial, com
  // equipe e atividades). A sincronização do Mercúrio não mexe nesses tipos.
  descricao       String?  @db.Text
  modalidade      String? // "presencial" | "online" | "misto"
  local           String?
  linkOnline      String?
  // GAF: por padrão só membros (2º nível em diante); true = alunos também.
  permiteAlunos   Boolean  @default(false)
  // GAF: programa de estudos que orienta os encontros.
  programa        String?  @db.Text
  criadoPorId     String?
  arquivadoEm     DateTime?
  createdAt       DateTime @default(now())

  atividades  GrupoAtividade[]
  memberships ClassMembership[]
  meetingSeries GroupMeetingSeries[]
  meetings GroupMeeting[]
  activities  Activity[]
  polls       Poll[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model ClassMembership {
  id           String     @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id])
  role         ClassRole // aluno | professor nesta turma
  createdAt    DateTime   @default(now())

  @@unique([classGroupId, memberId, role])
  @@index([memberId])
}

// Atividade cadastrada pelo professor (prova, trabalho, leitura...) e
// exibida para os alunos da turma dentro de "Agenda & Eventos" no Portal
// do Membro (não é uma seção nova — reaproveita a caixinha existente).
model Activity {
  id           String       @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup   @relation(fields: [classGroupId], references: [id])
  createdById  String
  createdBy    Member       @relation("ActivityCreator", fields: [createdById], references: [id])
  type         ActivityType
  title        String
  studyItems   String?      @db.Text // itens/conteúdo a estudar
  // Prova/trabalho/leitura de turma (2026-10-21): matéria em curso na turma
  // (TurmaMateria) e temas escolhidos do catálogo (lib/temas-curriculo.ts).
  materiaSigla String?
  materiaNome  String?
  temas        String[]     @default([])
  description  String?      @db.Text
  dueDate      DateTime
  createdAt    DateTime     @default(now())

  notifications ActivityNotification[]

  @@index([classGroupId])
}

// Enquete criada pelo professor para uma turma — os alunos votam numa
// opção (1 voto por membro, ver PollVote) e o resultado aparece igual a
// uma atividade dentro de "Agenda & Eventos" no Portal do Membro.
model Poll {
  id           String     @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  createdById  String
  createdBy    Member     @relation("PollCreator", fields: [createdById], references: [id])
  question     String
  createdAt    DateTime   @default(now())

  options PollOption[]
  votes   PollVote[]

  @@index([classGroupId])
}

model PollOption {
  id     String @id @default(cuid())
  pollId String
  poll   Poll   @relation(fields: [pollId], references: [id])
  label  String

  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id           String     @id @default(cuid())
  pollId       String
  poll         Poll       @relation(fields: [pollId], references: [id])
  pollOptionId String
  pollOption   PollOption @relation(fields: [pollOptionId], references: [id])
  memberId     String
  member       Member     @relation(fields: [memberId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([pollId, memberId])
  @@index([pollOptionId])
}

// Registro de envio de notificação por aluno (WhatsApp hoje; push como
// evolução futura via PWA). Permite reenviar e auditar quem foi avisado.
model ActivityNotification {
  id         String              @id @default(cuid())
  activityId String
  activity   Activity            @relation(fields: [activityId], references: [id])
  memberId   String
  member     Member              @relation(fields: [memberId], references: [id])
  channel    NotificationChannel @default(whatsapp)
  status     NotificationStatus  @default(pendente)
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([activityId])
  @@index([memberId])
}

// ===================== Auditoria de Cadastro =====================
// Toda alteração de contato feita pelo aluno no Portal gera um registro
// com o antes/depois. Se o aluno estiver com contribuição em atraso no
// momento da alteração, a secretaria de economia é alertada (alertedEconomia).
//
// `status` — pedido do usuário 2026-10-08: campos sensíveis (WhatsApp,
// e-mail) deixam de ser editados direto pelo aluno — viram uma SOLICITAÇÃO
// (status "pendente", `newValues` ainda não aplicado em Member) que o
// Secretário de Escolástica aprova ou rejeita (ver escolastica-actions.ts).
// Endereço continua de edição direta (status "aplicado" — mesmo
// comportamento de sempre, newValues já foi gravado em Member na hora).
model ContactChangeLog {
  id               String    @id @default(cuid())
  memberId         String
  member           Member    @relation(fields: [memberId], references: [id])
  oldValues        Json
  newValues        Json
  status           String    @default("aplicado") // "aplicado" | "pendente" | "aprovado" | "rejeitado"
  memberWasOverdue Boolean   @default(false)
  alertedEconomia  Boolean   @default(false)
  acknowledgedAt   DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([memberId])
}

// ===================== Fila de Sincronização com o Mercúrio =====================
// Abstração de transporte: cada alteração feita no Portal que precisa
// refletir no Mercúrio vira uma tarefa aqui. O worker que efetivamente
// escreve no Mercúrio (API, acesso a banco ou RPA — a definir) consome
// esta fila, então trocar de transporte não muda o resto do sistema.
model MercurioSyncTask {
  id        String             @id @default(cuid())
  memberId  String
  member    Member             @relation(fields: [memberId], references: [id])
  taskType  String // "atualizar_contato" | outros no futuro
  payload   Json
  status    MercurioSyncStatus @default(pendente)
  attempts  Int                @default(0)
  lastError String?
  createdAt DateTime           @default(now())
  syncedAt  DateTime?

  @@index([memberId])
  @@index([status])
}

// ===================== Termo de Voluntariado =====================
// Assinatura eletrônica do Termo de Voluntariado (Portal do Voluntário —
// ver src/lib/volunteer-term.ts pro texto vigente). "Assinar" aqui é
// digitar o nome completo de confirmação, não um desenho/captura
// biométrica — nível de e-signature equivalente ao resto do Portal
// (mesmo padrão de "confiar no login" usado em toda ação do membro).
// termVersion referencia VOLUNTEER_TERM_VERSION (código) — se o texto do
// termo mudar, a versão muda junto e quem já assinou precisa assinar nesse
// e assinaturas antigas continuam guardadas, sem confundir com a vigente.
model VolunteerTermSignature {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  termVersion String
  signedName  String
  signedAt    DateTime @default(now())
  // Filial em que foi assinado (novo termo ao mudar de filial) e o texto
  // exato assinado, já preenchido — registro do documento.
  schoolId    String?
  signedText  String?

  @@index([memberId])
}

// ===================== Monitoramento de erros =====================
// Decisão do usuário 2026-09-22: erros em produção (Server Actions, Route
// Handlers, render) devem virar um alerta pro suporte (WhatsApp via
// CallMeBot, ver error-notify.ts) o quanto antes, sem esperar o usuário
// reclamar. `fingerprint` (rota + mensagem, ver error-notify.ts) dedupe pra
// não floodar o WhatsApp com o MESMO erro repetido (ex: um cron falhando a
// cada 10min) — só reavisa depois de JANELA_DEDUPE_MIN.
// Membro de filial NÃO aberta (School.portalAberto=false) liberado pra
// testar o Portal por um dirigente — pedido do usuário 2026-10-18 ("os
// testadores são escolhidos pelos dirigentes, não por mim"). Chave é a
// matrícula, não Member.id: a pessoa pode ainda nem ter feito o primeiro
// acesso (Member só é criado nesse momento).
model TestadorLiberado {
  mercurioId   String   @id // matrícula
  unidade      String // unidades.uni_id da filial da pessoa
  liberadoPor  String // matrícula de quem liberou
  liberadoEm   DateTime @default(now())

  @@index([unidade])
}

// Quem pode liberar testadores em QUALQUER filial (além dos dirigentes de
// cada uma) — lista nominal definida pelo usuário 2026-10-18.
model LiberadorNacional {
  mercurioId String   @id // matrícula
  nome       String
  criadoEm   DateTime @default(now())
}

model ErrorNotification {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  message        String   @db.Text
  count          Int      @default(1)
  firstSeenAt    DateTime @default(now())
  lastNotifiedAt DateTime
}


// Liberação em camadas da área de voluntários (grupos Feminino/Masculino/
// de Segurança, avisos, escalas) — informação sensível, nada aparece por
// padrão. Chefe de Filial tem acesso sempre e libera quem quiser; quem foi
// liberado e é responsável por um grupo libera os integrantes desse grupo.
// Ver src/lib/acesso-voluntario.ts.
model AcessoVoluntario {
  memberId      String   @id
  liberadoPorId String
  liberadoEm    DateTime @default(now())

  @@index([liberadoPorId])
}


// Reuniões: ocorrências explícitas, cancelamento sem apagar histórico.
model GroupMeeting {
  id String @id @default(cuid())
  classGroupId String
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id])
  createdById String
  createdBy Member @relation("MeetingCreator", fields: [createdById], references: [id])
  seriesId String?
  seriesSlot String?
  title String
  startsAt DateTime
  endsAt DateTime
  timeZone String
  required Boolean @default(true)
  publicDetails String @default("") @db.Text
  internalDetails String @default("") @db.Text
  fullUniform Boolean @default(false)
  status String @default("agendada")
  cancellationReason String?
  version Int @default(0)
  // Notificações push (2026-10-21): marcam o envio para não repetir.
  lembreteEnviadoEm DateTime?
  presencaPerguntadaEm DateTime?
  createdAt DateTime @default(now())
  responses GroupMeetingResponse[]
  auditLog GroupMeetingAudit[]
  presencas GrupoPresenca[]
  @@index([classGroupId, startsAt])
  @@index([seriesId, startsAt])
  @@unique([seriesId, seriesSlot])
}

model GroupMeetingResponse {
  id String @id @default(cuid())
  meetingId String
  meeting GroupMeeting @relation(fields: [meetingId], references: [id])
  memberId String
  member Member @relation(fields: [memberId], references: [id])
  response String
  justification String? @db.Text
  updatedAt DateTime @updatedAt
  @@unique([meetingId, memberId])
}

model GroupMeetingAudit {
  id String @id @default(cuid())
  meetingId String
  meeting GroupMeeting @relation(fields: [meetingId], references: [id])
  actorId String
  actor Member @relation("MeetingAuditor", fields: [actorId], references: [id])
  action String
  changes Json
  createdAt DateTime @default(now())
  @@index([meetingId, createdAt])
}


// Rotina semanal permanente; só materializa as próximas ocorrências.
model GroupMeetingSeries {
  id String @id @default(cuid())
  classGroupId String
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id])
  createdById String
  createdBy Member @relation(fields: [createdById], references: [id])
  startsLocal String
  endsLocal String
  timeZone String
  template Json
  changes Json @default("[]")
  untilSlot String?
  // 1 = semanal, 2 = quinzenal, 4 = a cada 4 semanas (GAF, GDVE, secretarias).
  intervaloSemanas Int @default(1)
  createdAt DateTime @default(now())
  @@index([classGroupId])
}

// Atividades de um grupo (secretaria, Grupo Feminino/Masculino/de Segurança,
// GDVE) e quem responde por cada uma (pedido do usuário 2026-10-19).
model GrupoAtividade {
  id           String     @id @default(cuid())
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  titulo       String
  descricao    String?    @db.Text
  responsaveis String[]   @default([]) // ids de Member, integrantes do grupo
  periodicidade String?   // texto livre: "toda semana", "no dia do evento"…
  status       String     @default("ativa") // ativa | pausada | concluida
  criadoPorId  String
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
  @@index([classGroupId])
}

// Depois do encontro, o Portal pergunta ao participante se ele foi. O motivo
// da ausência é opcional e a pessoa pode preferir não informar.
model GrupoPresenca {
  id           String       @id @default(cuid())
  meetingId    String
  meeting      GroupMeeting @relation(fields: [meetingId], references: [id])
  memberId     String
  participou   Boolean
  motivo       String?      @db.Text
  naoInformou  Boolean      @default(false)
  respondidoEm DateTime     @default(now())
  @@unique([meetingId, memberId])
  @@index([memberId])
}


// Designação específica para recepção, sem acesso ao painel financeiro.
model EventReception {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId], references:[id])
  memberId String
  @@unique([eventId,memberId])
  @@index([memberId])
}
model EventAudit {
  id String @id @default(cuid())
  eventId String
  event Event @relation(fields:[eventId], references:[id])
  actorId String
  action String
  changes Json
  createdAt DateTime @default(now())
  @@index([eventId,createdAt])
}
model EventNotice {
  id String @id @default(cuid())
  registrationId String
  registration EventRegistration @relation(fields:[registrationId], references:[id])
  kind String
  dueAt DateTime
  status String @default("aguardando_canal")
  sentAt DateTime?
  @@unique([registrationId,kind])
  @@index([status,dueAt])
}

// Recursos do Portal do Aluno liberados por filial (pedido do usuário
// 2026-10-19): painéis sem função real ficam ocultos até um administrador
// da filial liberar. Chaves em src/lib/recursos-filial.ts.
model RecursoFilial {
  schoolId      String
  chave         String
  ativo         Boolean  @default(false)
  alteradoPorId String
  alteradoEm    DateTime @default(now())

  @@id([schoolId, chave])
}

// Administradores da filial no Portal: escolhidos pelo Chefe ou pelo
// Sub-Chefe da filial (que já são administradores por natureza).
model AdministradorFilial {
  schoolId       String
  memberId       String
  designadoPorId String
  criadoEm       DateTime @default(now())

  @@id([schoolId, memberId])
  @@index([memberId])
}

// ===================== Avaliação de instrutores =====================
// Pedido do usuário 2026-10-19. Ver src/lib/avaliacao.ts.

// Vínculo oficial turma → matéria → instrutor (Mercúrio turmas_materias),
// atualizado pela sincronização diária. É ele que define quem cada aluno
// pode avaliar (os instrutores da própria turma, com as matérias deles).
model TurmaMateria {
  id                String   @id @default(cuid())
  schoolId          String
  classGroupId      String
  materiaSigla      String
  materiaNome       String
  instrutorMatr     String
  instrutorNome     String
  instrutorMemberId String?
  inicio            DateTime?
  syncedAt          DateTime @default(now())

  @@unique([classGroupId, materiaSigla])
  @@index([schoolId])
  @@index([instrutorMatr])
}

// Questionário da filial (cópia editável da base nacional, que fica no código).
model AvaliacaoQuestionario {
  schoolId        String   @id
  titulo          String
  introducao      String
  perguntas       Json
  atualizadoPorId String
  atualizadoEm    DateTime @default(now())
}

// Rodada liberada pela Direção ou Secretaria de Escolástica. Guarda a cópia
// das perguntas no momento da abertura (mudanças posteriores no questionário
// não alteram uma rodada já aberta). turmas vazio = todas as turmas.
model AvaliacaoCampanha {
  id           String    @id @default(cuid())
  schoolId     String
  titulo       String
  introducao   String
  perguntas    Json
  turmas       String[]  @default([])
  status       String    @default("aberta") // "aberta" | "encerrada"
  abertaEm     DateTime  @default(now())
  encerradaEm  DateTime?
  criadoPorId  String

  @@index([schoolId, status])
}

// Quem já respondeu — só pra impedir resposta dupla. Não tem data nem
// ligação com a resposta (anonimato). alvo = "geral" ou "instrutor:<matr>:<classGroupId>".
model AvaliacaoParticipacao {
  campanhaId String
  memberId   String
  alvo       String

  @@id([campanhaId, memberId, alvo])
}

// Resposta anônima: sem memberId, id aleatório e só o dia (sem hora).
model AvaliacaoResposta {
  id            String   @id
  campanhaId    String
  schoolId      String
  parte         String // "instrutor" | "geral"
  classGroupId  String?
  turmaNome     String?
  instrutorMatr String?
  instrutorNome String?
  materias      String[] @default([])
  respostas     Json
  dia           DateTime @db.Date

  @@index([campanhaId, parte])
  @@index([schoolId])
  @@index([instrutorMatr])
}

// Resumo diário da filial para o Relatório do Painel do Diretor (pessoas,
// movimento, aniversariantes, contribuição, receita, turmas) — calculado
// pela sincronização a partir do banco de consulta do Mercúrio. Ver
// src/lib/mercurio-db/resumo-filial.ts.
model ResumoFilial {
  schoolId String   @id
  geradoEm DateTime @default(now())
  dados    Json
}

// Resumos de toda a OINAB-N (todas as unidades do Mercúrio, não só as
// filiais com Portal), gerados na sincronização diária. chave = "profissoes"...
model ResumoNacional {
  chave    String   @id
  geradoEm DateTime @default(now())
  dados    Json
}

// ===================== Tesouraria (importar extrato → Mercúrio) =====================
// Trazida para dentro do Portal em 2026-10-19 (antes: mercurio-tesouraria
// com Upstash Redis). Ver src/tesouraria/lib/armazenamento.js. escopo = id
// da filial no Portal (regras e catálogos separados por filial).
model TesourariaArquivo {
  escopo       String
  nome         String
  conteudo     String   @db.Text
  atualizadoEm DateTime @default(now())

  @@id([escopo, nome])
}

model TesourariaValor {
  escopo       String
  chave        String
  valor        Json
  atualizadoEm DateTime @default(now())

  @@id([escopo, chave])
}

model TesourariaJob {
  id       String   @id
  criadoEm DateTime @default(now())

  @@index([criadoEm])
}

model TesourariaJobEvento {
  jobId    String
  posicao  Int
  evento   Json
  criadoEm DateTime @default(now())

  @@id([jobId, posicao])
  @@index([criadoEm])
}

model TesourariaTrava {
  chave    String   @id
  dono     String
  expiraEm DateTime
}

// Quem voltou a senha de quem para a inicial (6 primeiros números do CPF) —
// feito pela administração da filial quando a pessoa esquece a senha.
model RedefinicaoSenha {
  id       String   @id @default(cuid())
  memberId String
  porId    String
  em       DateTime @default(now())
  @@index([memberId])
}

// Sub-chefe tem por padrão todos os acessos do chefe (pedido do usuário
// 2026-10-19); o chefe pode retirar áreas específicas manualmente. Uma linha
// por área retirada (direcao, escolastica, economia, eventos, cafe, admin).
model AcessoRetiradoSubchefe {
  id       String   @id @default(cuid())
  schoolId String
  memberId String
  area     String
  porId    String
  em       DateTime @default(now())
  @@unique([schoolId, memberId, area])
  @@index([memberId])
}

// Inscrição de notificação push (PWA) de um aparelho — pedido do usuário
// 2026-10-21 ("como ainda não temos o app, prepare a versão PWA"). Cada
// navegador/celular em que a pessoa ativou as notificações vira uma linha;
// inscrições que o serviço de push recusa (404/410) são apagadas no envio.
model PushSubscription {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  ultimoEnvioEm DateTime?
  @@index([memberId])
}

// Avisos agendados já enviados (2026-10-21): evita repetir o mesmo aviso
// push quando a rotina de 5 em 5 minutos roda de novo. A chave descreve o
// aviso, ex.: "evento:<id>", "pedido-cadastro:<id>", "vencimento:<memberId>:2026-10:d3".
model PushEnviado {
  chave    String   @id
  criadoEm DateTime @default(now())
}

// Lista de espera de evento lotado (pedido do usuário 2026-10-22). Quando
// abre vaga, o primeiro da fila é avisado (push) e a vaga fica reservada a
// ele por 12 h (avisadoEm); depois disso a vez passa ao próximo.
model EventWaitlist {
  id        String    @id @default(cuid())
  eventId   String
  memberId  String
  createdAt DateTime  @default(now())
  avisadoEm DateTime?
  @@unique([eventId, memberId])
  @@index([eventId, createdAt])
}

// Credencial de terceiro isolada: nunca incluir na serialização genérica de Member.
model AcropolePlayAccess {
  memberId        String   @id
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sourceStudentId String   @unique
  source          AcropolePlayStudent @relation(fields: [sourceStudentId], references: [sourceStudentId], onDelete: Cascade)
  emailHash       String
  loginCiphertext String
  importedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Catálogo privado também atende alunos ativos que ainda não criaram login.
model AcropolePlayStudent {
  sourceStudentId       String @id
  emailHash             String
  nameHash              String
  loginCiphertext       String
  mercurioId            String?
  mercurioUnit          String?
  reconciliationStatus  String
  mercurioSnapshotAt    DateTime?
  importedAt            DateTime @default(now())
  updatedAt             DateTime @updatedAt
  access                AcropolePlayAccess?
  @@index([emailHash])
  @@index([mercurioId])
}

// Planejamento por filial. Registros e avaliações são históricos append-only.
model AberturaTurma {
  mercurioTurmaId String?
  inscricoesAte DateTime?
  id String @id @default(cuid())
  schoolId String
  autorId String
  titulo String
  primeiraAula DateTime
  diaSemana Int
  inicioMinuto Int
  duracaoMinutos Int @default(120)
  capacidade Int
  metaMatriculas Int
  orcamentoCentavos Int @default(0)
  sala String
  status String @default("rascunho")
  professorIds String[] @default([])
  revisao Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  registros AberturaRegistro[]
  @@index([schoolId, primeiraAula])
}
model AberturaRegistro {
  id String @id @default(cuid())
  aberturaId String
  abertura AberturaTurma @relation(fields:[aberturaId],references:[id],onDelete:Cascade)
  autorId String
  tipo String
  dados Json
  createdAt DateTime @default(now())
  @@index([aberturaId,tipo,createdAt])
}
model ProfessorDisponibilidade {
  id String @id @default(cuid())
  schoolId String
  professorId String
  diaSemana Int
  inicioMinuto Int
  fimMinuto Int
  validaDe String
  validaAte String
  impedimentos Json @default("[]")
  habilitado Boolean @default(false)
  autorId String
  createdAt DateTime @default(now())
  @@index([schoolId,professorId])
}
model SecretariaEscala {
  id String @id @default(cuid())
  schoolId String
  secretaria String
  memberId String
  funcao String
  diaSemana Int
  inicioMinuto Int
  fimMinuto Int
  validaDe String
  validaAte String
  confirmado Boolean @default(false)
  autorId String
  createdAt DateTime @default(now())
  @@index([schoolId,diaSemana])
}
model AberturaConfig {
  schoolId String @id
  capacidadeEscola Int?
  funcoesNecessarias String[] @default([])
  compartilharAprendizados Boolean @default(false)
  revisao Int @default(0)
  updatedAt DateTime @updatedAt
}
model AberturaCrmCache {
  schoolId String @id
  dados Json
  sincronizadoEm DateTime @default(now())
}
model SecretariaMandato {
  id String @id @default(cuid())
  memberId String
  secretaria String
  escopo String
  schoolIds String[] @default([])
  ufs String[] @default([])
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([memberId,ativo])
}
model SecretariaPublicacao {
  id String @id @default(cuid())
  secretaria String
  autorId String
  titulo String
  tipo String
  conteudo String
  url String?
  schoolIds String[] @default([])
  ufs String[] @default([])
  inicio DateTime?
  fim DateTime?
  versao Int @default(1)
  exigeLeitura Boolean @default(false)
  publicado Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([secretaria,publicado])
}
model SecretariaLeitura {
  id String @id @default(cuid())
  publicacaoId String
  memberId String
  versao Int
  lidoEm DateTime @default(now())
  @@unique([publicacaoId,memberId,versao])
}

// Telas de TV da filial (pedido do usuário 2026-10-24): link público, sem login, que mostra em
// rotação os eventos dos públicos escolhidos. O token é o segredo do link; trocar o token
// derruba o link antigo. publicos: "aberto_publico" (eventos do Ulisses) e as chaves de
// EVENT_AUDIENCES (todos_ativos, membros, fv, provacionistas, hd, dirigentes).
model TelaEventos {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  nome      String
  publicos  String[] @default([])
  // Conteúdos intercalados com os eventos (lib/telas-publicos.ts: CONTEUDOS_TELA) e
  // orientação ("auto" | "direita" | "esquerda" = vertical girada) — pedidos de 2026-10-24.
  conteudos  String[] @default([])
  orientacao String   @default("auto")
  token     String   @unique
  criadoPor String?
  createdAt DateTime @default(now())
  conexoes  TvConexao[]

  @@index([schoolId])
}

// Cartões que a filial escreve para as TVs (avisos, Círculo de Amigos, Instagram, Acrópole Play).
model TelaCartao {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  tipo      String // "aviso" | "apoio" | "instagram" | "play"
  titulo    String
  texto     String?
  link      String?
  ate       DateTime? // some da TV depois deste dia
  criadoPor String?
  createdAt DateTime  @default(now())

  @@index([schoolId])
}

// Conexão TV ↔ tela pelo controle remoto: a TV abre /tv, mostra um código de 6 números
// e um QR; um voluntário logado escolhe a tela; a TV (que guarda o segredo) é levada a ela.
model TvConexao {
  id          String       @id @default(cuid())
  codigo      String       @unique
  segredo     String       @unique
  telaId      String?
  tela        TelaEventos? @relation(fields: [telaId], references: [id], onDelete: Cascade)
  expiraEm    DateTime
  conectadoEm DateTime?
  createdAt   DateTime     @default(now())

  @@index([expiraEm])
}
